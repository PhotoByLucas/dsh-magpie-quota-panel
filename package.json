{
  "name": "@local/magpie-quota",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Canvai1337",
  "description": "Shows magpie's account quota below the composer: the chip's glyph and number both express the usable share of all account quota, and clicking it opens a native-style call-out panel with each account's total quota and one model usage limit.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "magpie",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canvai1337/dsh-magpie-quota.git"
  },
  "homepage": "https://github.com/Canvai1337/dsh-magpie-quota#readme",
  "bugs": {
    "url": "https://github.com/Canvai1337/dsh-magpie-quota/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
